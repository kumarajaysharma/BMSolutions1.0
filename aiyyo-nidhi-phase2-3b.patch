+  gst_tds_rate_bps            INTEGER NOT NULL DEFAULT 200,
+  -- BOCW Labour Cess (basis points: 100 = 1.00%)
+  labor_cess_rate_bps         INTEGER NOT NULL DEFAULT 100,
