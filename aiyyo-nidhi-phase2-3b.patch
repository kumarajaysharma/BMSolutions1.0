+  rate_minor_units      BIGINT NOT NULL DEFAULT 0,
+  currency_code         TEXT NOT NULL DEFAULT 'INR',
+  -- Analysis percentages: real acceptable — NOT monetary values
+  labour_component_pct  REAL NOT NULL DEFAULT 0,
